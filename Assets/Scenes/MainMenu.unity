  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Welcome to Basket Challenge!\r\nReady to score some hoops? This is the
    place to train, have fun, and see how far your skills can take you!\r\nStart
    with Solo Training Mode to get the hang of it, then challenge the CPU and prove
    who\u2019s the real MVP.\r Choose from different difficulty levels\u2014they\u2019ll
    make the game tougher but also boost your coin bonuses. Better start stacking
    them\u2026 you\u2019ll find out how to use them in a future update!\r\nThe gameplay
    is simple and intuitive: swipe while filling the side bar to shoot. Hit the orange
    zone and BOOM\u2014perfect shot! Land in the purple zone, and you\u2019ll pull
    off a sweet backboard shot. But wait, there\u2019s more: curve your swipe slightly
    left or right to add a backspin and rack up bonus points! The more hoops you
    sink, the higher your level climbs\u2026 and if you\u2019re good enough, unlock
    Fireball Mode: 10 seconds of fire and double points for every shot!\r\nWhat are
    you waiting for? Hit the court, power up that swipe, and own the backboard!\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 44120aa8c73b15d47968ba2f6fc94ecb, type: 2}
  m_sharedMaterial: {fileID: 6698546097254780305, guid: 44120aa8c73b15d47968ba2f6fc94ecb, type: 2}
